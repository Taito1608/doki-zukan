# Supabase の Project Settings → API で確認できる値
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Cloud の OAuth クライアントID（Supabase に登録したものと同じ）
# 設定すると、Google のログイン画面に Supabase の URL ではなくアプリのドメインが表示される
# 空のままなら、従来の Supabase 経由のログインになる
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# （任意）定期アクセス /api/cron/keepalive を Vercel Cron 以外から呼べないようにする合言葉
CRON_SECRET=

# 誕生日の通知（Web Push）用の鍵。`npx web-push generate-vapid-keys` で作成する
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 通知の送り主の連絡先（mailto: か https:// の URL）
VAPID_SUBJECT=
# 通知を全員に送るための Supabase の管理用キー（Project Settings → API の service_role）。絶対に公開しないこと
SUPABASE_SERVICE_ROLE_KEY=
